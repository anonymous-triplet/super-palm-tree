extends SceneTree

## Sites the city's smart car parks and writes sumo/parking_lots.json.
##
## A lot lies on the right-hand side of a street (the side cars drive on), behind the footpath: a 22 m x 16 m surface whose
## street-side edge is 12 m from the road centreline, with a driveway across the footpath at the middle of its frontage.
## Cars stop at the kerb in front of the driveway ("pos", a SUMO lane position) where the barrier lets them in. A site is kept
## only when the whole surface, the driveway and the strip in front of the barrier are free of buildings, trees, poles, signs and
## devices, and the lot stays clear of station aprons and refuse containers. One lot per chosen sector, spread over the city.
##
## Run: godot --headless --path . --script tools/compute_parking_lots.gd

const RoadGeometry := preload("res://scripts/incidents/road_geometry.gd")
const WorldObstacleIndex := preload("res://scripts/incidents/world_obstacle_index.gd")
const Sectors := preload("res://scripts/city_sectors.gd")
const OUTPUT := "res://sumo/parking_lots.json"
const DEPOTS_PATH := "res://sumo/emergency_depots.json"
const BINS_PATH := "res://sumo/garbage_bins.json"
const INNER_OFFSET := 12.0
const LOT_LENGTH := 22.0
const LOT_DEPTH := 16.0
const CAPACITY := 12
const CANDIDATE_POSITIONS := [40.0, 30.0, 50.0, 22.0, 58.0]
## Sectors that get a lot, in order of preference.
const SECTOR_ORDER := ["B", "C", "E", "G", "H", "J", "L", "N", "O", "K", "F", "I"]
const MAX_LOTS := 8

var _index := WorldObstacleIndex.new()
var _aprons: Array[Rect2] = []
var _bins: Array[Vector2] = []
var _why := {}

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var city := (load("res://scenes/City.tscn") as PackedScene).instantiate() as Node3D
	root.add_child(city)
	for _frame in 8:
		await process_frame
	var central_trees: Array = []
	var central_buildings := city.get_node_or_null("Buildings")
	if central_buildings != null:
		central_trees = central_buildings.find_children("Tree_*", "Node3D", true, false)
	_index.build(self, central_trees)
	for depot_value in (JSON.parse_string(FileAccess.get_file_as_string(DEPOTS_PATH)) as Dictionary).get("depots", []) as Array:
		var apron := (depot_value as Dictionary).get("apron", []) as Array
		if apron.size() == 4:
			_aprons.append(Rect2(float(apron[0]), float(apron[1]), float(apron[2]), float(apron[3])).grow(14.0))
	for bin_value in (JSON.parse_string(FileAccess.get_file_as_string(BINS_PATH)) as Dictionary).get("bins", []) as Array:
		_bins.append(Vector2(float((bin_value as Dictionary).x), float((bin_value as Dictionary).z)))
	var by_sector := {}
	for edge_id in _edges():
		var edge := RoadGeometry.parse_edge(edge_id)
		for position_value in CANDIDATE_POSITIONS:
			var site := _try_site(edge, float(position_value))
			if site.is_empty():
				continue
			var sector := str(site.sector)
			if not by_sector.has(sector):
				by_sector[sector] = []
			(by_sector[sector] as Array).append(site)
	print("WHY ", _why, " sectors with sites: ", by_sector.keys())
	var lots: Array = []
	for sector in SECTOR_ORDER:
		if lots.size() >= MAX_LOTS or not by_sector.has(sector):
			continue
		var options := by_sector[sector] as Array
		options.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return float(a.score) < float(b.score))
		for option_value in options:
			var option := option_value as Dictionary
			var gate := Vector2(float(option.x), float(option.z))
			var far_enough := true
			for lot_value in lots:
				var lot := lot_value as Dictionary
				if gate.distance_to(Vector2(float(lot.x), float(lot.z))) < 120.0:
					far_enough = false
			if far_enough:
				lots.append(option)
				break
	var output: Array = []
	for index in lots.size():
		var lot := lots[index] as Dictionary
		lot.erase("score")
		lot["id"] = "LOT-%s" % Sectors.block_label(Vector3(float(lot.x), 0.0, float(lot.z)))
		lot["capacity"] = CAPACITY
		lot["popularity"] = 3.0 if index == 0 else (2.0 if index == 1 else 1.0)
		output.append(lot)
	var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
	file.store_string(JSON.stringify({"_comment": "Generated by tools/compute_parking_lots.gd. edge/pos is the kerb stop in front of the barrier (SUMO lane position); x/z is the barrier; the lot lies on the right of the edge from 12 m to 28 m off the centreline.", "inner_offset": INNER_OFFSET, "length": LOT_LENGTH, "depth": LOT_DEPTH, "lots": output}, "\t"))
	file.close()
	print("PARKING_LOTS_OK lots=", output.size(), " sectors=", output.map(func(l): return l.sector))
	quit(0)

func _edges() -> Array[String]:
	var edges: Array[String] = []
	for row in range(1, 10):
		for column in range(1, 10):
			for step in [Vector2i(0, 1), Vector2i(1, 0), Vector2i(0, -1), Vector2i(-1, 0)]:
				var to_row: int = row + step.x
				var to_column: int = column + step.y
				if to_row < 1 or to_row > 9 or to_column < 1 or to_column > 9:
					continue
				edges.append("E_r%dc%d_r%dc%d" % [row, column, to_row, to_column])
	return edges

func _reject(reason: String) -> Dictionary:
	var key := reason.get_slice(":", 0) + (":" + reason.get_slice(":", 1).substr(0, 14) if reason.begins_with("hard") else "")
	_why[key] = int(_why.get(key, 0)) + 1
	if reason.begins_with("driveway") and int(_why.get("shown", 0)) < 4:
		_why["shown"] = int(_why.get("shown", 0)) + 1
		print("DRIVEWAY BLOCKERS ", reason)
	return {}

func _try_site(edge: Dictionary, position_value: float) -> Dictionary:
	var yaw := RoadGeometry.yaw_of(edge.direction as Vector3)
	var gate := RoadGeometry.side_point(edge, position_value, INNER_OFFSET)
	gate.y = 0.17
	var gate_xz := Vector2(gate.x, gate.z)
	for apron in _aprons:
		if apron.has_point(gate_xz):
			return _reject("apron")
	for bin_position in _bins:
		if bin_position.distance_to(gate_xz) < 11.0:
			return _reject("bin")
	var surface_centre := RoadGeometry.side_point(edge, position_value, INNER_OFFSET + LOT_DEPTH * 0.5)
	var driveway := RoadGeometry.side_point(edge, position_value, (RoadGeometry.KERB_OFFSET + INNER_OFFSET) * 0.5)
	var blockers: Array = []
	blockers.append_array(_index.oriented_box_blockers(surface_centre, yaw, LOT_LENGTH, LOT_DEPTH, 0.35))
	blockers.append_array(_index.oriented_box_blockers(driveway, yaw, 5.2, INNER_OFFSET - RoadGeometry.KERB_OFFSET + 1.0, 0.2))
	# Outer-district scenery, trees and kerb furniture may be cleared for a car park; buildings of the core, devices,
	# poles, reservoirs and everything else may not.
	var cleared: Array = []
	for blocker in blockers:
		var label := str(blocker)
		if label.begins_with("BackdropBlock_") or label.begins_with("Street_") or label.begins_with("Tree") or label.begins_with("tree"):
			if not label in cleared:
				cleared.append(label)
		else:
			return _reject("hard:" + label)
	# The whole lot must stay on this street's straight, clear of both junction boxes.
	if position_value - LOT_LENGTH * 0.5 < 6.0 or position_value + LOT_LENGTH * 0.5 > RoadGeometry.LANE_LENGTH - 6.0:
		return {}
	var sector := Sectors.sector_of(gate.x, gate.z)
	# Prefer sites near the middle of their sector.
	var score := Vector2(gate.x, gate.z).distance_to(Vector2(Sectors.centre(sector).x, Sectors.centre(sector).z)) + float(cleared.size()) * 25.0
	return {"clear": cleared, "edge": str(edge.id), "pos": snappedf(position_value, 0.1), "x": snappedf(gate.x, 0.01), "z": snappedf(gate.z, 0.01), "yaw": snappedf(yaw, 0.0001), "sector": sector, "score": score}
