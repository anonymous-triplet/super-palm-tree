extends SceneTree

## Computes collision-free emergency stations and writes sumo/emergency_depots.json.
##
## For each station the tool scans the road edges around its facility for a
## parallel parking apron (beyond the citizen walking band) plus, for every bay,
## a pull-out corridor to the lane, and rejects any placement that touches a
## building, tree, pole, signal post, device, utility asset or citizen job prop.
## The bridge reads the resulting SUMO edge/positions; Godot reads the same file
## for bay poses, so both sides agree on one physical station layout.
##
## Run: godot --headless --path . --script tools/compute_emergency_depots.gd

const RoadGeometry := preload("res://scripts/incidents/road_geometry.gd")
const DepotPaths := preload("res://scripts/incidents/depot_paths.gd")
const WorldObstacleIndex := preload("res://scripts/incidents/world_obstacle_index.gd")
const CitySpatialSafety := preload("res://scripts/city_spatial_safety.gd")
const OUTPUT := "res://sumo/emergency_depots.json"
const CLASSES_PATH := "res://sumo/vehicle_classes.json"
## Bay centre offset from the road centreline: beyond the walking band
## (≤ 11.4 m) plus half the widest unit and a 0.6 m margin.
const APRON_OFFSET := 13.6
const APRON_HALF_DEPTH := 1.9
## A 6 m gap lets a unit pull out forward on its S-curve with ≥1.9 m
## clearance to the vehicle parked in the next bay.
const BAY_GAP := 6.0
const PULL_OUT_LENGTH := 14.0
const ARRIVAL_CLEARANCE := 1.5
const STATIONS := [
	{"id": "POLICE-HQ", "label": "Police Headquarters", "facility": "Buildings/Block_r1c2/Block_r1c2_Building_02",
		"units": [["POL-1", "police", "patrol"], ["POL-2", "police", "patrol"], ["POL-3", "police", "garaged"], ["POL-4", "police", "garaged"]]},
	{"id": "HOSPITAL-F.4", "label": "Hospital F.4 EMS", "facility": "Buildings/Block_r2c2/Block_r2c2_Building_03",
		"units": [["AMB-1", "ambulance", "garaged"], ["AMB-2", "ambulance", "garaged"]]},
	{"id": "HOSPITAL-E.2", "label": "Hospital E.2 EMS", "facility": "CityBackdrop/OuterDistricts/OuterBlock_r3c2/BackdropBlock_r3c2_Building_04",
		"units": [["AMB-3", "ambulance", "garaged"]]},
	{"id": "FIRE-STATION", "label": "Fire Station 1", "near": Vector3(118.0, 0.0, 52.0), "near_options": [Vector3(118.0, 0.0, 52.0), Vector3(142.5, 0.0, -47.5), Vector3(47.5, 0.0, 142.5), Vector3(142.5, 0.0, 142.5), Vector3(237.5, 0.0, 47.5)], "designate_building": true,
		"units": [["FIRE-1", "fire", "garaged"], ["FIRE-2", "fire", "garaged"]]},
	{"id": "TOW-YARD", "label": "Recovery & Tow Yard", "near": Vector3(-140.0, 0.0, 150.0),
		"units": [["TOW-1", "tow", "garaged"], ["TOW-2", "tow", "garaged"]]},
	{"id": "UTILITY-DEPOT", "label": "Water & Power Utility Depot", "near": Vector3(-47.5, 0.0, -237.5),
		"units": [["UTL-1", "utility", "garaged"], ["UTL-2", "utility", "garaged"]]},
	{"id": "SANITATION-DEPOT", "label": "Municipal Sanitation Depot", "near": Vector3(237.5, 0.0, 142.5),
		"units": [["GRB-1", "garbage", "garaged"], ["GRB-2", "garbage", "garaged"]]},
]

var _index := WorldObstacleIndex.new()
var _classes: Dictionary = {}
var _claimed_rects: Array[Rect2] = []
var _city: Node3D


func _initialize() -> void:
	call_deferred("_run")


func _run() -> void:
	_classes = (JSON.parse_string(FileAccess.get_file_as_string(CLASSES_PATH)) as Dictionary).get("classes", {}) as Dictionary
	_city = (load("res://scenes/City.tscn") as PackedScene).instantiate() as Node3D
	root.add_child(_city)
	# NpcAi places and deconflicts job props during its ready pass.
	for _frame in 6:
		await process_frame
	var central_trees: Array = []
	var central_buildings := _city.get_node_or_null("Buildings")
	if central_buildings != null:
		central_trees = central_buildings.find_children("Tree_*", "Node3D", true, false)
	_index.build(self, central_trees)
	print("DEPOT_TOOL obstacles=", _index.entry_count())
	var output: Array = []
	var failed := false
	for station_value in STATIONS:
		var station := (station_value as Dictionary).duplicate(true)
		var result := _site_station(station)
		for near_option in station.get("near_options", []):
			if not result.is_empty():
				break
			station.near = near_option
			result = _site_station(station)
		if result.is_empty():
			printerr("DEPOT_TOOL_FAILED no collision-free site for ", station.id)
			failed = true
			continue
		output.append(result)
		print("DEPOT_TOOL ", result.id, " edge=", result.edge, " bays=", (result.bays as Array).size(), " facility=", result.get("facility", ""), " door=", result.door)
	if failed:
		quit(1)
		return
	var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
	file.store_string(JSON.stringify({"_comment": "Generated by tools/compute_emergency_depots.gd. Bays are parallel aprons beyond the citizen walking band; exit_pos/arrive_pos are SUMO lane positions on 'edge'.", "depots": output}, "\t"))
	file.close()
	print("DEPOT_TOOL_OK depots=", output.size())
	quit(0)


func _unit_dims(visual_class: String) -> Vector2:
	var spec := _classes.get(visual_class, {}) as Dictionary
	return Vector2(float(spec.get("length", 5.0)), float(spec.get("width", 2.5)))


func _site_station(station: Dictionary) -> Dictionary:
	var facility: Node3D = null
	var near: Vector3
	if station.has("facility"):
		facility = _city.get_node_or_null(str(station.facility)) as Node3D
		if facility == null:
			printerr("DEPOT_TOOL missing facility ", station.facility)
			return {}
		near = CitySpatialSafety.world_bounds(facility).get_center()
	else:
		near = station.near as Vector3
	# Patrol units live on the network and resume patrol after an incident;
	# only garaged units occupy a physical bay.
	var units: Array = []
	var patrol_units: Array = []
	for unit_value in station.units as Array:
		if str((unit_value as Array)[2]) == "patrol":
			patrol_units.append(unit_value)
		else:
			units.append(unit_value)
	var bay_lengths: Array[float] = []
	for unit_value in units:
		bay_lengths.append(_unit_dims(str((unit_value as Array)[1])).x)
	var best := {}
	var best_score := INF
	for row in range(1, 10):
		for column in range(1, 10):
			for step in [Vector2i(0, 1), Vector2i(1, 0), Vector2i(0, -1), Vector2i(-1, 0)]:
				var to_row: int = row + (step as Vector2i).x
				var to_column: int = column + (step as Vector2i).y
				if to_row < 1 or to_row > 9 or to_column < 1 or to_column > 9:
					continue
				var edge := RoadGeometry.parse_edge("E_r%dc%d_r%dc%d" % [row, column, to_row, to_column])
				var mid := ((edge.start as Vector3) + (edge.end as Vector3)) * 0.5
				if mid.distance_to(near) > 110.0:
					continue
				# The apron must be on the facility's side of the road.
				if (near - mid).dot(edge.right as Vector3) <= 0.0:
					continue
				var candidate := _best_on_edge(edge, bay_lengths, near)
				if candidate.is_empty():
					continue
				if float(candidate.score) < best_score:
					best_score = float(candidate.score)
					best = candidate
	if best.is_empty():
		return {}
	var edge := best.edge_data as Dictionary
	var bays: Array = []
	for bay_index in units.size():
		var unit := units[bay_index] as Array
		var dims := _unit_dims(str(unit[1]))
		var s := float((best.bay_positions as Array)[bay_index])
		var centre := RoadGeometry.side_point(edge, s, APRON_OFFSET)
		bays.append({
			"unit": str(unit[0]), "class": str(unit[1]), "start": str(unit[2]),
			"s": snappedf(s, 0.01), "x": snappedf(centre.x, 0.001), "z": snappedf(centre.z, 0.001),
			"yaw": snappedf(RoadGeometry.yaw_of(edge.direction as Vector3), 0.0001),
			"length": dims.x, "width": dims.y,
			"exit_pos": snappedf(s + PULL_OUT_LENGTH, 0.01),
			"arrive_pos": snappedf(s - PULL_OUT_LENGTH, 0.01),
		})
	_claimed_rects.append(best.apron_rect as Rect2)
	if facility == null and bool(station.get("designate_building", false)):
		facility = _nearest_building(best.apron_centre as Vector3)
	var door: Vector3
	if facility != null:
		var bounds := CitySpatialSafety.world_bounds(facility).grow(0.7)
		var apron_centre := best.apron_centre as Vector3
		door = Vector3(clampf(apron_centre.x, bounds.position.x, bounds.end.x), 0.17, clampf(apron_centre.z, bounds.position.z, bounds.end.z))
	else:
		door = RoadGeometry.side_point(edge, float((best.bay_positions as Array)[0]), APRON_OFFSET + APRON_HALF_DEPTH + 1.6)
		door.y = 0.17
	var patrols: Array = []
	for unit_value in patrol_units:
		var unit := unit_value as Array
		patrols.append({"unit": str(unit[0]), "class": str(unit[1]), "start": "patrol", "length": _unit_dims(str(unit[1])).x, "width": _unit_dims(str(unit[1])).y})
	var result := {
		"id": str(station.id), "label": str(station.label), "edge": str(edge.id), "patrol_units": patrols,
		"door": [snappedf(door.x, 0.001), snappedf(door.z, 0.001)], "bays": bays,
		"apron": [snappedf((best.apron_rect as Rect2).position.x, 0.01), snappedf((best.apron_rect as Rect2).position.y, 0.01), snappedf((best.apron_rect as Rect2).size.x, 0.01), snappedf((best.apron_rect as Rect2).size.y, 0.01)],
	}
	if facility != null:
		result["facility"] = str(_city.get_path_to(facility))
	return result


func _best_on_edge(edge: Dictionary, bay_lengths: Array[float], near: Vector3) -> Dictionary:
	var span := 0.0
	for length in bay_lengths:
		span += length + BAY_GAP
	span -= BAY_GAP
	var best := {}
	var best_score := INF
	# Leave PULL_OUT_LENGTH on both sides of the bay run inside the 78 m lane so
	# both the pull-out and the return turn-in finish before a junction, and the
	# unit waiting at its arrival point (front at s - PULL_OUT_LENGTH) stands
	# wholly on the edge, never with its rear in the junction box.
	var first_start := PULL_OUT_LENGTH + bay_lengths[0] + ARRIVAL_CLEARANCE
	var last_start := RoadGeometry.LANE_LENGTH - PULL_OUT_LENGTH - span + bay_lengths[0] * 0.5 - 2.0
	var s_start := first_start
	while s_start <= last_start:
		var positions: Array[float] = []
		var cursor := s_start - bay_lengths[0] * 0.5
		for length in bay_lengths:
			positions.append(cursor + length * 0.5)
			cursor += length + BAY_GAP
		var apron := _edge_rect(edge, positions[0] - bay_lengths[0] * 0.5 - 1.0, positions[-1] + bay_lengths[-1] * 0.5 + 1.0, APRON_OFFSET - APRON_HALF_DEPTH, APRON_OFFSET + APRON_HALF_DEPTH)
		var ok := _index.rect_blockers(apron, 0.3).is_empty() and not _overlaps_claimed(apron)
		if ok:
			# Every bay's real swept pull-out and turn-in footprints (the exact
			# curves the presenter drives) must clear the static world.
			for bay_index in positions.size():
				var length := bay_lengths[bay_index]
				var bay := {"x": 0.0, "z": 0.0, "exit_pos": positions[bay_index] + PULL_OUT_LENGTH, "arrive_pos": positions[bay_index] - PULL_OUT_LENGTH}
				var centre_point := RoadGeometry.side_point(edge, positions[bay_index], APRON_OFFSET)
				bay.x = centre_point.x
				bay.z = centre_point.z
				var width := 2.8
				if not DepotPaths.sweep_blockers(_index, DepotPaths.pull_out_curve(edge, bay), length, width, 0.35).is_empty() \
						or not DepotPaths.sweep_blockers(_index, DepotPaths.turn_in_curve(edge, bay), length, width, 0.35).is_empty():
					ok = false
					break
		if ok:
			var centre := RoadGeometry.side_point(edge, (positions[0] + positions[-1]) * 0.5, APRON_OFFSET)
			var score := centre.distance_to(near)
			if score < best_score:
				best_score = score
				best = {"edge_data": edge, "bay_positions": positions, "apron_rect": apron, "apron_centre": centre, "score": score}
		s_start += 1.0
	return best


func _edge_rect(edge: Dictionary, s_from: float, s_to: float, lateral_from: float, lateral_to: float) -> Rect2:
	var corners := [
		RoadGeometry.side_point(edge, s_from, lateral_from), RoadGeometry.side_point(edge, s_to, lateral_from),
		RoadGeometry.side_point(edge, s_from, lateral_to), RoadGeometry.side_point(edge, s_to, lateral_to),
	]
	var rect := Rect2((corners[0] as Vector3).x, (corners[0] as Vector3).z, 0.0, 0.0)
	for corner_value in corners:
		var corner := corner_value as Vector3
		rect = rect.expand(Vector2(corner.x, corner.z))
	return rect


func _overlaps_claimed(rect: Rect2) -> bool:
	for claimed in _claimed_rects:
		if claimed.grow(4.0).intersects(rect):
			return true
	return false


func _nearest_building(point: Vector3) -> Node3D:
	var best: Node3D = null
	var best_distance := INF
	for value in get_nodes_in_group("buildings") + get_nodes_in_group("backdrop_buildings"):
		var building := value as Node3D
		if building == null or building.is_in_group("hospitals") or building.is_in_group("police_facilities"):
			continue
		var bounds := CitySpatialSafety.world_bounds(building)
		var closest := Vector3(clampf(point.x, bounds.position.x, bounds.end.x), 0.0, clampf(point.z, bounds.position.z, bounds.end.z))
		var distance := closest.distance_to(Vector3(point.x, 0.0, point.z))
		if distance < best_distance:
			best_distance = distance
			best = building
	return best
