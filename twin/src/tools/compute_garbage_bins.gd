extends SceneTree

## Sites the city's large green wheeled refuse containers and writes
## sumo/garbage_bins.json.
##
## One container stands at the kerb of a street, on the driving side of its
## edge, outside the citizen walking band. A site is kept only when the
## container, the strip a worker wheels it across to the truck's hopper and
## the truck's stopping place leave every tree, pole, signal, device, citizen
## job prop and station apron untouched. The bridge reads edge/pos to stop the
## collection truck; Godot reads x/z/yaw to place the container.
##
## Run: godot --headless --path . --script tools/compute_garbage_bins.gd

const RoadGeometry := preload("res://scripts/incidents/road_geometry.gd")
const WorldObstacleIndex := preload("res://scripts/incidents/world_obstacle_index.gd")
const OUTPUT := "res://sumo/garbage_bins.json"
const DEPOTS_PATH := "res://sumo/emergency_depots.json"
## Container footprint (1100 l four-wheel bin): along the kerb x depth.
const BIN_LENGTH := 1.38
const BIN_DEPTH := 1.1
## Centre offset from the road centreline: kerb at 5.75 m, a 0.35 m margin.
const BIN_OFFSET := 6.65
const CANDIDATE_POSITIONS := [38.0, 30.0, 46.0, 24.0, 52.0]
const MIN_SPACING := 80.0
## The truck's tail stops this far past the bin (lane positions).
const TAIL_PAST_BIN := 2.0
const TRUCK_LENGTH := 8.6

var _index := WorldObstacleIndex.new()
var _aprons: Array[Rect2] = []


func _initialize() -> void:
	call_deferred("_run")


func _run() -> void:
	var city := (load("res://scenes/City.tscn") as PackedScene).instantiate() as Node3D
	root.add_child(city)
	for _frame in 6:
		await process_frame
	var central_trees: Array = []
	var central_buildings := city.get_node_or_null("Buildings")
	if central_buildings != null:
		central_trees = central_buildings.find_children("Tree_*", "Node3D", true, false)
	_index.build(self, central_trees)
	var depots := (JSON.parse_string(FileAccess.get_file_as_string(DEPOTS_PATH)) as Dictionary).get("depots", []) as Array
	for depot_value in depots:
		var apron := (depot_value as Dictionary).get("apron", []) as Array
		if apron.size() == 4:
			# Stations' bays, driveways and pull-out corridors stay clear.
			_aprons.append(Rect2(float(apron[0]), float(apron[1]), float(apron[2]), float(apron[3])).grow(22.0))
	var sites: Array = []
	for edge_id in _interior_edges():
		var edge := RoadGeometry.parse_edge(edge_id)
		for position_value in CANDIDATE_POSITIONS:
			var site := _try_site(edge, float(position_value), sites)
			if not site.is_empty():
				sites.append(site)
				break
	var output: Array = []
	for index in sites.size():
		var site := sites[index] as Dictionary
		site.id = "BIN-%02d" % (index + 1)
		output.append(site)
	var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
	file.store_string(JSON.stringify({"_comment": "Generated by tools/compute_garbage_bins.gd. pos is the bin's SUMO lane position on edge; stop_pos the truck's front at the collection stop.", "bins": output}, "\t"))
	file.close()
	print("GARBAGE_BINS_OK bins=", output.size())
	quit(0)


func _interior_edges() -> Array[String]:
	## Streets between interior junctions (rows/columns 2-8), in a stable order.
	var edges: Array[String] = []
	for row in range(2, 9):
		for column in range(2, 9):
			for step in [Vector2i(0, 1), Vector2i(1, 0), Vector2i(0, -1), Vector2i(-1, 0)]:
				var to_row: int = row + step.x
				var to_column: int = column + step.y
				if to_row < 2 or to_row > 8 or to_column < 2 or to_column > 8:
					continue
				edges.append("E_r%dc%d_r%dc%d" % [row, column, to_row, to_column])
	return edges


func _try_site(edge: Dictionary, position_value: float, sites: Array) -> Dictionary:
	var direction := edge.direction as Vector3
	var yaw := RoadGeometry.yaw_of(direction)
	var centre := RoadGeometry.side_point(edge, position_value, BIN_OFFSET)
	centre.y = 0.17
	for site_value in sites:
		var other := site_value as Dictionary
		if Vector2(float(other.x) - centre.x, float(other.z) - centre.z).length() < MIN_SPACING:
			return {}
	for apron in _aprons:
		if apron.has_point(Vector2(centre.x, centre.z)):
			return {}
	# The container itself, with room to grab and wheel it.
	if not _index.oriented_box_blockers(centre, yaw, BIN_LENGTH, BIN_DEPTH, 0.45).is_empty():
		return {}
	# The kerb strip it is wheeled across, from the bin to behind the tail.
	var strip_centre := RoadGeometry.side_point(edge, position_value + 0.6, 5.0)
	if not _index.oriented_box_blockers(strip_centre, yaw, 4.2, 3.6, 0.2).is_empty():
		return {}
	var stop_pos := position_value + TAIL_PAST_BIN + TRUCK_LENGTH
	if stop_pos > RoadGeometry.LANE_LENGTH - 4.0:
		return {}
	return {
		"edge": str(edge.id), "pos": snappedf(position_value, 0.1), "stop_pos": snappedf(stop_pos, 0.1),
		"x": snappedf(centre.x, 0.01), "z": snappedf(centre.z, 0.01), "yaw": snappedf(yaw, 0.0001),
	}
