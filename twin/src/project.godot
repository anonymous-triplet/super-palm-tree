; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="City Ground Zero"
run/main_scene="res://scenes/City.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/lg-out.png"
boot_splash/bg_color=Color(0.067, 0.075, 0.098, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/branding/splash.png"
boot_splash/stretch_mode=1
boot_splash/minimum_display_time=1500
boot_splash/use_filter=true

[autoload]

AppBranding="*res://scripts/app_branding.gd"

[display]

window/size/mode=2
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4

textures/default_filters/anisotropic_filtering_level=16
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.18, 0.22, 0.28, 1)
anti_aliasing/quality/use_taa=true

[shader_globals]

vehicle_lamp_clock={
"type": "float",
"value": 0.0
}
city_night_factor={
"type": "float",
"value": 0.0
}
